# mock (default): runs fully in the browser, data saved in localStorage
# remote: use the FastAPI backend in ../backend (run it on :8000)
VITE_API_MODE=mock

# Field sensor device API (proxied by Vite at /sensor; see vite.config.js)
VITE_SENSOR_DEVICE_ID=FS-NE-0012
# SENSOR_API_URL=https://h9173qw8-8080.usw2.devtunnels.ms
# SENSOR_TUNNEL_TOKEN=   # only needed if the devtunnel is private

# STRATA crop model (POST /api/v1/prescribe). Proxied by Vite at /model, see vite.config.js
MODEL_BASE_URL=https://backlash-handlebar-scheme.ngrok-free.dev
